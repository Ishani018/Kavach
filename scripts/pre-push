#!/bin/sh
# Kavach pre-push validation hook.
# Installed via scripts/install-hooks.sh -- see VALIDATION_PROTOCOL.md.
#
# Runs Tier A always. Runs Tier B additionally when the push includes
# changes under parliament/, corpus_v2/, or vocabulary/pattern files
# (the paths that actually affect detection logic) -- keeps a fast
# pre-push hook fast for pushes that only touch docs/benchmarks/etc.
#
# Written in POSIX sh, no head/awk-only assumptions -- must work on
# Windows Git Bash as well as Linux/macOS.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-push] Running Tier A (unit suites)..."
python validate.py --tier A -q
TIER_A_STATUS=$?

if [ "$TIER_A_STATUS" -ne 0 ]; then
    echo "[pre-push] Tier A FAILED -- push blocked. Fix the failing test(s) above."
    exit 1
fi

# Detect whether this push touches detection-relevant paths.
CHANGED_FILES=$(git diff --name-only @{push} HEAD 2>/dev/null || git diff --name-only origin/HEAD HEAD 2>/dev/null || echo "")
if [ -z "$CHANGED_FILES" ]; then
    # Fallback: no upstream tracking ref available yet (e.g. first push
    # of a new branch) -- diff against the merge-base with main instead.
    CHANGED_FILES=$(git diff --name-only "$(git merge-base HEAD main 2>/dev/null || echo HEAD)" HEAD 2>/dev/null || echo "")
fi

TOUCHES_DETECTION_LOGIC=false
for f in $CHANGED_FILES; do
    case "$f" in
        parliament/*|corpus_v2/*|*vocab*|*pattern*)
            TOUCHES_DETECTION_LOGIC=true
            ;;
    esac
done

if [ "$TOUCHES_DETECTION_LOGIC" = true ]; then
    echo "[pre-push] Detection-relevant paths changed -- running Tier B (sampled replay census)..."
    echo "[pre-push] Requires a live Kavach server at 127.0.0.1:8088."
    python validate.py --tier B -q
    TIER_B_STATUS=$?
    if [ "$TIER_B_STATUS" -ne 0 ]; then
        echo "[pre-push] Tier B FAILED -- push blocked. See the diff above against locked_baseline.json."
        exit 1
    fi
else
    echo "[pre-push] No detection-relevant paths changed -- skipping Tier B."
fi

echo "[pre-push] Validation passed."
exit 0
